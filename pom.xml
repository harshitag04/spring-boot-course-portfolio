<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version> <!-- Use whatever version your course uses -->
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-boot-course-portfolio</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging> <!-- Critical: Tells Maven this is a parent container -->

    <!-- This links your independent homework sub-folders -->
    <modules>
        <module>college-management-module</module>
        <module>department-module</module>
        <module>library-management-module</module>
    </modules>

    <properties>
        <java.version>21</java.version> <!-- Use your current Java version -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <lombok.version>1.18.34</lombok.version>
    </properties>

    <!-- Global dependencies that EVERY homework assignment will use -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
